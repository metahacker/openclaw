# This fork-only lane is reachable solely through the supported release wrapper.
# It does not alter the canonical OpenClaw App Store identity or publish metadata.
require "base64"
require "openssl"
require "tmpdir"
require "net/http"
require "uri"

module PearOLSRelease
  # The original PEAR app. The experiment is a separate "PEAR MVP" app and never uploads here.
  LEGACY_PEAR_APP_ID = "6759186465".freeze

  def self.config
    JSON.parse(File.read(File.expand_path("../pear-experiment/release.json", __dir__)))
  end

  def self.request(method, path, payload = nil)
    uri = URI.join("https://api.appstoreconnect.apple.com", path)
    unless uri.scheme == "https" && uri.host == "api.appstoreconnect.apple.com"
      raise "Invalid App Store Connect request destination"
    end
    request = Net::HTTP.const_get(method.capitalize).new(uri)
    Spaceship::ConnectAPI.token.refresh! if Spaceship::ConnectAPI.token.expired?
    request["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    request["Content-Type"] = "application/json"
    request.body = JSON.generate(payload) if payload
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 20, read_timeout: 60) { |http| http.request(request) }
    unless response.is_a?(Net::HTTPSuccess)
      raise "App Store Connect #{method} failed (HTTP #{response.code}); response body withheld"
    end
    response.body.to_s.empty? ? {} : JSON.parse(response.body)
  end

  def self.next_build(app)
    uploads = app_store_uploads(app.id)
    numbers = uploads.map do |upload|
      detail = upload.state
      state = detail.is_a?(Hash) ? detail["state"].to_s : ""
      unless %w[AWAITING_UPLOAD PROCESSING FAILED COMPLETE].include?(state)
        raise "Unknown Apple upload state; refusing build-number allocation"
      end
      if %w[AWAITING_UPLOAD PROCESSING].include?(state)
        raise "Another Apple-visible upload is unresolved; reconcile it before a new release"
      end
      number = upload.cf_build_version.to_s
      raise "Unrecognized Apple build number" unless number.match?(/\A[0-9]+\z/)
      number.to_i
    end
    # Older successful builds may precede Apple's buildUploads history endpoint.
    app.get_builds(limit: 200).each do |build|
      number = build.version.to_s
      raise "Unrecognized historical Apple build number" unless number.match?(/\A[0-9]+\z/)
      numbers << number.to_i
    end
    (numbers.max || 0) + 1
  end

  def self.app_store_uploads(app_id)
    Spaceship::ConnectAPI.get_build_uploads(app_id: app_id, filter: { platform: "IOS" }, includes: nil, limit: 200, sort: nil).all_pages.flat_map(&:to_models)
  end

  # Copy the raw xcodebuild log into the proof directory with key material removed.
  def self.preserve_archive_log(directory, target)
    logs = Dir.glob(File.join(directory, "*.log")).sort_by { |path| File.mtime(path) }
    return if logs.empty?
    text = File.read(logs.last, encoding: "UTF-8", invalid: :replace, undef: :replace)
    text = text.gsub(/-authenticationKey(Path|ID|IssuerID)\s+\S+/, "-authenticationKey\\1 <redacted>")
    %w[ASC_KEY_ID ASC_ISSUER_ID].each do |name|
      value = ENV[name].to_s
      text = text.gsub(value, "<redacted>") unless value.empty?
    end
    File.write(target, text)
  rescue StandardError => error
    UI.important("Could not preserve the archive log: #{error.class}")
  end

  # Re-encode the key as the exact PKCS#8 form Apple ships in a downloaded .p8
  # (P-256, no inner curve parameters). OpenSSL-based fastlane accepts re-encoded
  # variants; Xcode's own signer rejected the stored one with "Authentication
  # failed: Make sure a bearer token was provided, it is properly configured and
  # signed". Returns [canonical PEM, original DER size, canonical DER size].
  def self.canonical_p8(pem)
    ec = OpenSSL::PKey::EC.new(pem)
    raise "App Store Connect key is not a P-256 key" unless ec.group.curve_name == "prime256v1"
    private_scalar = ec.private_key.to_s(2).rjust(32, "\0")
    public_point = ec.public_key.to_octet_string(:uncompressed)
    ec_private_key = OpenSSL::ASN1::Sequence.new([
      OpenSSL::ASN1::Integer.new(1),
      OpenSSL::ASN1::OctetString.new(private_scalar),
      OpenSSL::ASN1::ASN1Data.new([OpenSSL::ASN1::BitString.new(public_point)], 1, :CONTEXT_SPECIFIC),
    ])
    pkcs8 = OpenSSL::ASN1::Sequence.new([
      OpenSSL::ASN1::Integer.new(0),
      OpenSSL::ASN1::Sequence.new([OpenSSL::ASN1::ObjectId.new("id-ecPublicKey"), OpenSSL::ASN1::ObjectId.new("prime256v1")]),
      OpenSSL::ASN1::OctetString.new(ec_private_key.to_der),
    ])
    der = pkcs8.to_der
    body = Base64.strict_encode64(der).scan(/.{1,64}/).join("\n")
    original_der_size = Base64.decode64(pem.lines.reject { |line| line.include?("-----") }.join).bytesize
    ["-----BEGIN PRIVATE KEY-----\n#{body}\n-----END PRIVATE KEY-----\n", original_der_size, der.bytesize]
  end

  # What manual App Store signing would need from Apple, recorded as facts only:
  # whether the public API exposes app groups, which of the four bundle IDs exist
  # and which capabilities they carry, and what the match store already holds.
  def self.provisioning_facts(bundle_ids)
    facts = {}
    facts[:appGroupsApi] = begin
      request("GET", "/v1/appGroups?limit=1")
      "200"
    rescue StandardError => error
      error.message[/HTTP (\d+)/, 1] || "error"
    end
    facts[:bundleIds] = bundle_ids.to_h do |identifier|
      detail = begin
        data = request("GET", "/v1/bundleIds?filter[identifier]=#{URI.encode_www_form_component(identifier)}&include=bundleIdCapabilities&limit=5")
        record = (data["data"] || []).find { |item| item.dig("attributes", "identifier") == identifier }
        if record
          caps = (data["included"] || []).map { |item| item.dig("attributes", "capabilityType") }.compact.sort
          { registered: true, capabilities: caps }
        else
          { registered: false }
        end
      rescue StandardError => error
        { error: error.message[/HTTP (\d+)/, 1] || "error" }
      end
      [identifier, detail]
    end
    facts[:matchStore] = match_store_inventory
    facts
  end

  # File names inside the match git store (certificate and profile inventory only).
  def self.match_store_inventory
    auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s
    pat = ENV["MATCH_GIT_PAT"].to_s
    secrets = [auth, pat].reject(&:empty?)
    attempts = []
    attempts << ["basic-header", ["git", "-c", "http.extraheader=AUTHORIZATION: basic #{auth}", "clone", "--depth", "1", "--quiet", "https://github.com/metahacker/fastlane-certs"]] unless auth.empty?
    attempts << ["pat-url", ["git", "clone", "--depth", "1", "--quiet", "https://x-access-token:#{pat}@github.com/metahacker/fastlane-certs"]] unless pat.empty?
    return { available: false, reason: "no MATCH_GIT_BASIC_AUTHORIZATION or MATCH_GIT_PAT" } if attempts.empty?
    failures = {}
    attempts.each do |label, command|
      Dir.mktmpdir("pear-match-") do |dir|
        _out, err, status = Open3.capture3(*command, dir)
        if status.success?
          entries = Dir.glob(File.join(dir, "**", "*")).select { |path| File.file?(path) }
          names = entries.map { |path| path.delete_prefix("#{dir}/") }.reject { |name| name.start_with?(".git") }.sort
          return { available: true, method: label, files: names.map { |name| name.gsub(/[0-9A-Z]{8,}/, "<id>") } }
        end
        reason = err.to_s.lines.map(&:strip).reject(&:empty?).last.to_s
        secrets.each { |value| reason = reason.gsub(value, "<redacted>") }
        failures[label] = reason.gsub(%r{https://[^\s]+}, "<url>")[0, 160]
      end
    end
    { available: false, failures: failures }
  rescue StandardError => error
    { available: false, reason: error.class.to_s }
  end
  rescue StandardError => error
    { available: false, reason: error.class.to_s }
  end

  def self.status_of(path)
    request("GET", path)
    "200"
  rescue StandardError => error
    error.message[/HTTP (\d+)/, 1] || "error"
  end

  # Role/type evidence for the existing key, without identifiers: the users endpoint
  # answers only for Admin/Account Holder keys; certificate and profile inventories
  # show what manual signing could reuse.
  def self.key_role_facts(bundle_prefix)
    facts = { usersEndpoint: status_of("/v1/users?limit=1") }
    facts[:distributionCertificates] = begin
      data = request("GET", "/v1/certificates?filter[certificateType]=IOS_DISTRIBUTION,DISTRIBUTION&limit=50")
      (data["data"] || []).map { |c| { type: c.dig("attributes", "certificateType"), expires: c.dig("attributes", "expirationDate").to_s[0, 10] } }
    rescue StandardError => error
      { error: error.message[/HTTP (\d+)/, 1] || "error" }
    end
    facts[:appStoreProfiles] = begin
      data = request("GET", "/v1/profiles?filter[profileType]=IOS_APP_STORE&limit=200")
      (data["data"] || []).map { |pr| { name: pr.dig("attributes", "name").to_s, state: pr.dig("attributes", "profileState") } }
        .select { |pr| pr[:name].include?(bundle_prefix) }
    rescue StandardError => error
      { error: error.message[/HTTP (\d+)/, 1] || "error" }
    end
    facts
  end

  # Registrations the existing key is already authorized to make through the public
  # API: missing companion App IDs and the capabilities the entitlements declare.
  # Every write records its HTTP result; 403 is direct evidence of a read-only key.
  def self.ensure_registrations(bundle_id)
    wanted = {
      bundle_id => { name: "PEAR MVP", capabilities: %w[PUSH_NOTIFICATIONS HEALTHKIT APP_GROUPS] },
      "#{bundle_id}.share" => { name: "PEAR MVP Share", capabilities: %w[APP_GROUPS] },
      "#{bundle_id}.activitywidget" => { name: "PEAR MVP Activity Widget", capabilities: [] },
      "#{bundle_id}.watchkitapp" => { name: "PEAR MVP Watch App", capabilities: [] },
    }
    wanted.to_h do |identifier, spec|
      result = {}
      record = begin
        data = request("GET", "/v1/bundleIds?filter[identifier]=#{URI.encode_www_form_component(identifier)}&include=bundleIdCapabilities&limit=5")
        found = (data["data"] || []).find { |item| item.dig("attributes", "identifier") == identifier }
        result[:existingCapabilities] = (data["included"] || []).map { |item| item.dig("attributes", "capabilityType") }.compact.sort if found
        found
      rescue StandardError
        nil
      end
      if record.nil?
        begin
          created = request("POST", "/v1/bundleIds", { data: { type: "bundleIds", attributes: { identifier: identifier, name: spec[:name], platform: "IOS" } } })
          record = created["data"]
          result[:bundleId] = "created"
        rescue StandardError => error
          result[:bundleId] = "create failed HTTP #{error.message[/HTTP (\d+)/, 1] || "?"}"
        end
      else
        result[:bundleId] = "exists"
      end
      if record
        result[:capabilities] = spec[:capabilities].to_h do |capability|
          outcome = if (result[:existingCapabilities] || []).include?(capability)
            "exists"
          else
            begin
              request("POST", "/v1/bundleIdCapabilities", { data: { type: "bundleIdCapabilities", attributes: { capabilityType: capability }, relationships: { bundleId: { data: { type: "bundleIds", id: record["id"] } } } } })
              "enabled"
            rescue StandardError => error
              "failed HTTP #{error.message[/HTTP (\d+)/, 1] || "?"}"
            end
          end
          [capability, outcome]
        end
      end
      [identifier, result]
    end
  end

  # Which provisioning endpoints this key may use. Xcode's automatic signing needs
  # certificates/identifiers/profiles access; only HTTP status codes are recorded.
  def self.key_scope
    %w[/v1/bundleIds?limit=1 /v1/certificates?limit=1 /v1/profiles?limit=1].to_h do |path|
      status = begin
        request("GET", path)
        "200"
      rescue StandardError => error
        error.message[/HTTP (\d+)/, 1] || "error"
      end
      [path.sub("/v1/", "").sub("?limit=1", ""), status]
    end
  end

  def self.internal_group(app)
    groups = app.get_beta_groups.select { |group| group.is_internal_group == true }
    selected = groups.select { |group| group.name == "PEAR Team" }
    selected = groups.select { |group| group.name == "Internal Testers" } if selected.empty?
    raise "An unambiguous existing PEAR internal testing group is required" unless selected.length == 1
    selected.first
  end
end

platform :ios do
  desc "Source-gated PEAR experimental internal TestFlight release"
  lane :pear_ols_release do
    unless ENV["OPENCLAW_IOS_RELEASE_WRAPPER"] == "1" && ENV["PEAR_OLS_EXPERIMENT"] == "1" && ENV["GITHUB_ACTIONS"] == "true"
      UI.user_error!("PEAR releases require the manually dispatched experiment workflow and pnpm ios:release:upload")
    end
    config = PearOLSRelease.config
    root = File.expand_path("../../..", __dir__)
    ios = File.join(root, "apps/ios")
    evidence = File.join(ios, "build/pear-ols-evidence")
    sh("python3", File.join(ios, "pear-experiment/verify-gate.py"))
    sh("python3", File.join(ios, "pear-experiment/verify-evidence.py"), evidence, ENV.fetch("GITHUB_SHA"), "--require-committed-formatting")
    unless release_source_clean?
      dirty, = Open3.capture3("git", "status", "--porcelain=v1", "--untracked-files=all", chdir: root)
      UI.error("Unclean paths (release refuses to archive):\n#{dirty}")
      UI.user_error!("PEAR release source must be committed and clean")
    end
    UI.user_error!("PEAR developer team mismatch") unless ENV["IOS_DEVELOPMENT_TEAM"] == config.fetch("teamId")
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].each { |name| UI.user_error!("Missing #{name}") if ENV[name].to_s.empty? }
    bundle_id = config.fetch("bundleId").to_s
    app_id = config.fetch("appId").to_s
    UI.user_error!("release.json bundleId is required") if bundle_id.empty?
    UI.user_error!("release.json appId is empty: the PEAR MVP App Store Connect record does not exist yet") if app_id.empty?
    UI.user_error!("Refusing to release into the original PEAR app") if app_id == PearOLSRelease::LEGACY_PEAR_APP_ID
    UI.user_error!("Refusing to release into the original PEAR app bundle") if !ENV["IOS_BUNDLE_ID"].to_s.empty? && bundle_id == ENV["IOS_BUNDLE_ID"]
    private_key = ENV.fetch("ASC_KEY_CONTENT").strip
    private_key = private_key.include?("BEGIN PRIVATE KEY") ? private_key.gsub('\\n', "\n") : Base64.strict_decode64(private_key)
    private_key += "\n" unless private_key.end_with?("\n")
    private_key, original_der_size, canonical_der_size = PearOLSRelease.canonical_p8(private_key)
    UI.important("App Store Connect key DER bytes: stored=#{original_der_size} canonical=#{canonical_der_size}")
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_content: private_key, is_key_content_base64: false)
    app = Spaceship::ConnectAPI::App.get(app_id: app_id)
    UI.user_error!("App Store Connect app does not carry the PEAR MVP bundle identifier") unless app.bundle_id == bundle_id
    UI.user_error!("Resolved App Store Connect app is the original PEAR app") if app.id.to_s == PearOLSRelease::LEGACY_PEAR_APP_ID
    group = PearOLSRelease.internal_group(app)
    build_number = PearOLSRelease.next_build(app)
    key_scope = PearOLSRelease.key_scope
    UI.important("App Store Connect key scope (HTTP): #{key_scope.map { |k, v| "#{k}=#{v}" }.join(" ")}")
    provisioning_facts = PearOLSRelease.provisioning_facts([bundle_id, "#{bundle_id}.share", "#{bundle_id}.activitywidget", "#{bundle_id}.watchkitapp"])
    UI.important("Provisioning facts: #{JSON.generate(provisioning_facts)}")
    if ENV["PEAR_OLS_PROVISION_ONLY"] == "true"
      # Evidence and authorized setup only: no build-number allocation, archive, or upload.
      role_facts = PearOLSRelease.key_role_facts(bundle_id)
      registrations = PearOLSRelease.ensure_registrations(bundle_id)
      after = PearOLSRelease.provisioning_facts([bundle_id, "#{bundle_id}.share", "#{bundle_id}.activitywidget", "#{bundle_id}.watchkitapp"])
      report = { sourceSha: ENV.fetch("GITHUB_SHA"), appId: app.id, internalGroupId: group.id, keyScope: key_scope, keyDerBytes: { stored: original_der_size, canonical: canonical_der_size }, keyRoleFacts: role_facts, before: provisioning_facts, registrations: registrations, after: after, state: "provision-facts" }
      UI.important("Provision-only report: #{JSON.generate(report)}")
      File.write(File.join(evidence, "release-receipt.json"), JSON.pretty_generate(report) + "\n")
      next
    end
    plan = { sourceSha: ENV.fetch("GITHUB_SHA"), appId: app.id, version: config.fetch("version"), buildNumber: build_number, internalGroupId: group.id, keyScope: key_scope, keyDerBytes: { stored: original_der_size, canonical: canonical_der_size }, provisioningFacts: provisioning_facts, state: "prepared" }
    receipt = File.join(evidence, "release-receipt.json")
    File.write(receipt, JSON.pretty_generate(plan) + "\n")
    sh("python3", File.join(ios, "pear-experiment/prepare.py"), "--build-number", build_number.to_s)
    sh("node", File.join(root, "scripts/ios-write-swift-filelist.mjs"))
    Dir.chdir(ios) { sh("xcodegen", "generate", "--spec", "project.pear-ols.generated.yml") }
    # Xcode's automatic signing rejected a randomly named temp key file with
    # "Authentication failed: Make sure a bearer token was provided"; it wants the
    # key where Xcode itself looks: ~/private_keys/AuthKey_<KEY_ID>.p8.
    key_dir = File.expand_path("~/private_keys")
    FileUtils.mkdir_p(key_dir, mode: 0o700)
    key_path = File.join(key_dir, "AuthKey_#{ENV.fetch("ASC_KEY_ID")}.p8")
    File.write(key_path, private_key)
    File.chmod(0o600, key_path)
    FileUtils.mkdir_p(File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles"))
    FileUtils.mkdir_p(File.expand_path("~/Library/MobileDevice/Provisioning Profiles"))
    auth_args = ["-authenticationKeyPath", key_path, "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"), "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")].shelljoin
    # Keep the raw xcodebuild log in evidence: xcbeautify hides Xcode's automatic
    # signing diagnostics, and a redacted copy is the only way to see why a profile
    # or capability could not be provisioned on a hosted runner.
    archive_logs = File.join(evidence, "archive-logs")
    begin
      ipa = build_app(project: File.join(ios, "OpenClaw.xcodeproj"), scheme: "OpenClaw", configuration: "Release", export_method: "app-store", clean: true, skip_profile_detection: true, output_directory: File.join(ios, "build/pear-ols-release"), output_name: "PEAR-OLS.ipa", xcargs: "DEVELOPMENT_TEAM=#{config.fetch("teamId")} -allowProvisioningUpdates #{auth_args}", export_xcargs: "-allowProvisioningUpdates", buildlog_path: archive_logs, export_options: { signingStyle: "automatic", teamID: config.fetch("teamId") })
    rescue StandardError => error
      PearOLSRelease.preserve_archive_log(archive_logs, File.join(evidence, "archive-log.txt"))
      raise error
    end
    sh("python3", File.join(ios, "pear-experiment/verify-ipa.py"), ipa, "--build-number", build_number.to_s)
    # Re-read the Apple-owned allocation immediately before the only upload attempt.
    UI.user_error!("Apple upload state changed during archive; re-plan on the next workflow run") unless PearOLSRelease.next_build(app) == build_number
    sh("python3", File.join(ios, "pear-experiment/verify-evidence.py"), evidence, ENV.fetch("GITHUB_SHA"), "--require-committed-formatting")
    plan[:state] = "upload-starting"
    File.write(receipt, JSON.pretty_generate(plan) + "\n")
    upload_to_testflight(api_key: api_key, app_identifier: app.bundle_id, apple_id: app.id, ipa: ipa, skip_waiting_for_build_processing: false, wait_processing_timeout_duration: 3600, skip_submission: true, distribute_external: false, notify_external_testers: false, submit_beta_review: false, uses_non_exempt_encryption: false, changelog: config.fetch("notes"))
    plan[:state] = "uploaded-processing-complete"
    File.write(receipt, JSON.pretty_generate(plan) + "\n")
    builds = app.get_builds(filter: { "preReleaseVersion.version" => config.fetch("version"), version: build_number.to_s }, includes: "preReleaseVersion")
    exact = builds.select { |candidate| candidate.app_version == config.fetch("version") && candidate.version == build_number.to_s }
    UI.user_error!("Cannot uniquely resolve the uploaded PEAR build") unless exact.length == 1
    build = exact.first
    apple_build = PearOLSRelease.request("GET", "/v1/builds/#{build.id}").fetch("data").fetch("attributes")
    UI.user_error!("Apple has not validated the uploaded build") unless apple_build["processingState"] == "VALID"
    group = PearOLSRelease.internal_group(app)
    UI.user_error!("Existing internal group changed during upload") unless group.id == plan[:internalGroupId]
    build.add_beta_groups(beta_groups: [group])
    deadline = Time.now + 600
    loop do
      details = PearOLSRelease.request("GET", "/v1/builds/#{build.id}/buildBetaDetail").fetch("data").fetch("attributes")
      state = details["internalBuildState"]
      break if state == "IN_BETA_TESTING"
      UI.user_error!("Uploaded build is not yet available to internal TestFlight (#{state})") if Time.now >= deadline
      sleep 15
    end
    assigned = app.get_beta_groups.select { |candidate| candidate.fetch_builds.any? { |entry| entry.id == build.id } }
    UI.user_error!("Internal TestFlight assignment could not be verified") unless assigned.any? { |candidate| candidate.id == group.id }
    UI.user_error!("Unexpected external distribution detected") if assigned.any? { |candidate| candidate.is_internal_group != true }
    plan.merge!(state: "IN_BETA_TESTING", buildId: build.id, verifiedInternalGroupIds: assigned.map(&:id))
    File.write(receipt, JSON.pretty_generate(plan) + "\n")
    UI.success("PEAR #{config.fetch('version')} (#{build_number}) verified in internal TestFlight")
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
